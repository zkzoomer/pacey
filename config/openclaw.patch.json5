{
  agents: {
    defaults: {
      model: {
        primary: "openai/gpt-5.6-luna",
      },
      skipBootstrap: true,
    },
  },

  session: {
    dmScope: "per-account-channel-peer",
  },

  tools: {
    profile: "messaging",
    sessions: {
      visibility: "self",
    },
    agentToAgent: {
      enabled: false,
    },
  },

  commands: {
    text: false,
    nativeSkills: false,
    bash: false,
    config: false,
    mcp: false,
    plugins: false,
    debug: false,
    restart: false,
  },

  channels: {
    telegram: {
      enabled: true,
      streaming: {
        mode: "off",
      },
      commands: {
        native: false,
      },
      customCommands: [
        {
          command: "goals",
          description: "Create, view, or update your athlete profile",
        },
        {
          command: "weight",
          description: "Log weight in kilograms",
        },
      ],
    },
  },

  plugins: {
    entries: {
      pacey: {
        hooks: {
          allowConversationAccess: true,
        },
      },
    },
  },
}
